# Fallback if the hosting cannot point the domain to the "public" folder:
# everything is routed into public/, all other folders (src, config, data, ...) are unreachable.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(src|config|data|migrations|templates|tests|bin)(/|$) - [F,L]
  RewriteRule (^|/)\. - [F,L]
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<IfModule !mod_rewrite.c>
  Require all denied
</IfModule>
